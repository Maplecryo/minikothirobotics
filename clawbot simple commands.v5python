{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode V5 Python Project\n# \n# ------------------------------------------\n\n# Library imports\nfrom vex import *\n\n# ---------------------------------------------------------------------------- #\n#                                                                              #\n#   Module:       main.py                                                      #\n#   Description:  VEX V5 Clawbot - driver control + simple autonomous          #\n#                                                                              #\n#   Standard Clawbot wiring:                                                   #\n#       Port 1  - Left drive motor                                             #\n#       Port 10 - Right drive motor (reversed)                                 #\n#       Port 3  - Claw motor                                                   #\n#       Port 8  - Arm motor                                                    #\n#                                                                              #\n# ---------------------------------------------------------------------------- #\n\nfrom vex import *\n\n# --- Devices ----------------------------------------------------------------\nbrain = Brain()\ncontroller = Controller(PRIMARY)\n\nleft_motor = Motor(Ports.PORT8, GearSetting.RATIO_6_1, False)\nright_motor = Motor(Ports.PORT7, GearSetting.RATIO_6_1, True)\nclaw_motor = Motor(Ports.PORT6, GearSetting.RATIO_18_1, False)\narm_motor = Motor(Ports.PORT12, GearSetting.RATIO_18_1, False)\n\n# Arm and claw hold their position when stopped, so gravity doesn't drop them.\narm_motor.set_stopping(HOLD)\nclaw_motor.set_stopping(HOLD)\n\nARM_SPEED = 60    # percent\nCLAW_SPEED = 50   # percent - keep this low so you don't crush the object\nDEADBAND = 5      # ignore small joystick drift\n\n\n# --- Helpers ----------------------------------------------------------------\ndef deadband(value):\n    if abs(value) < DEADBAND:\n        return 0\n    return value\n\n\n# --- Autonomous -------------------------------------------------------------\ndef autonomous():\n    brain.screen.clear_screen()\n    brain.screen.print(\"Autonomous\")\n\n    # Open the claw\n    claw_motor.spin_for(REVERSE, 180, DEGREES, CLAW_SPEED, PERCENT)\n\n    # Drive forward toward the object\n    left_motor.spin_for(FORWARD, 700, DEGREES, 50, PERCENT, wait=False)\n    right_motor.spin_for(FORWARD, 700, DEGREES, 50, PERCENT, wait=True)\n\n    # Close the claw to grab it\n    claw_motor.spin_for(FORWARD, 180, DEGREES, CLAW_SPEED, PERCENT)\n\n    # Lift the arm\n    arm_motor.spin_for(FORWARD, 400, DEGREES, ARM_SPEED, PERCENT)\n\n    # Back away\n    left_motor.spin_for(REVERSE, 700, DEGREES, 50, PERCENT, wait=False)\n    right_motor.spin_for(REVERSE, 700, DEGREES, 50, PERCENT, wait=True)\n\n    left_motor.stop()\n    right_motor.stop()\n\n\n# --- Driver control ---------------------------------------------------------\ndef driver_control():\n    brain.screen.clear_screen()\n    brain.screen.print(\"Driver Control\")\n\n    while True:\n        # Tank drive\n        left_motor.set_velocity(deadband(controller.axis3.position()), PERCENT)\n        right_motor.set_velocity(deadband(controller.axis2.position()), PERCENT)\n        left_motor.spin(FORWARD)\n        right_motor.spin(FORWARD)\n\n        # Arm: L1 raises, L2 lowers\n        if controller.buttonL1.pressing():\n            arm_motor.spin(FORWARD, ARM_SPEED, PERCENT)\n        elif controller.buttonL2.pressing():\n            arm_motor.spin(REVERSE, ARM_SPEED, PERCENT)\n        else:\n            arm_motor.stop()\n\n        # Claw: R1 closes, R2 opens\n        if controller.buttonR1.pressing():\n            claw_motor.spin(FORWARD, CLAW_SPEED, PERCENT)\n        elif controller.buttonR2.pressing():\n            claw_motor.spin(REVERSE, CLAW_SPEED, PERCENT)\n        else:\n            claw_motor.stop()\n\n        wait(20, MSEC)\n\n\n# --- Competition setup ------------------------------------------------------\ncompetition = Competition(driver_control, autonomous)\n","textLanguage":"python","robotConfig":[],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}